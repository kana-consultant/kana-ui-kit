{
  "name": "@kana-consultant/ui-kit",
  "version": "0.2.0",
  "type": "module",
  "description": "A modern React UI kit for building back-office apps and admin dashboards — accessible primitives, dashboard blocks, TanStack Form + TanStack Store integrations, Tailwind v4 design tokens, Storybook included.",
  "keywords": [
    "react",
    "ui-kit",
    "component-library",
    "design-system",
    "backoffice",
    "admin",
    "dashboard",
    "tailwind",
    "tailwindcss",
    "storybook",
    "radix-ui",
    "tanstack-form",
    "tanstack-store",
    "tanstack-table",
    "data-table",
    "accessible",
    "typescript"
  ],
  "license": "MIT",
  "author": "Maulana Sodiqin <maulanasdqn@gmail.com>",
  "homepage": "https://github.com/kana-consultant/kana-ui-kit",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kana-consultant/kana-ui-kit.git"
  },
  "bugs": {
    "url": "https://github.com/kana-consultant/kana-ui-kit/issues"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": [
    "**/*.css"
  ],
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./styles.css": "./dist/index.css",
    "./styles": "./dist/index.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vite --mode playground",
    "build": "tsc -b && vite build && node scripts/copy-styles.mjs",
    "build:playground": "vite build --mode playground",
    "preview": "vite preview --mode playground",
    "typecheck": "tsc -b --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint": "tsc -b --noEmit",
    "prepublishOnly": "pnpm typecheck && pnpm build"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "dependencies": {
    "@radix-ui/react-avatar": "^1.1.2",
    "@radix-ui/react-checkbox": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.4",
    "@radix-ui/react-dropdown-menu": "^2.1.4",
    "@radix-ui/react-label": "^2.1.1",
    "@radix-ui/react-popover": "^1.1.4",
    "@radix-ui/react-progress": "^1.1.1",
    "@radix-ui/react-select": "^2.1.4",
    "@radix-ui/react-separator": "^1.1.1",
    "@radix-ui/react-slot": "^1.1.1",
    "@radix-ui/react-switch": "^1.1.2",
    "@radix-ui/react-tabs": "^1.1.2",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.1.6",
    "@tanstack/react-form": "^1.23.4",
    "@tanstack/react-store": "^0.7.6",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/store": "^0.7.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "tailwind-merge": "^3.3.1",
    "zod": "^4.1.14"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^4.1.1",
    "@storybook/addon-a11y": "^10.3.5",
    "@storybook/addon-docs": "^10.3.5",
    "@storybook/addon-themes": "^10.3.5",
    "@storybook/react-vite": "^10.3.5",
    "@tailwindcss/vite": "^4.2.0",
    "@types/node": "^24.9.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.1",
    "@vitejs/plugin-react": "^5.1.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "storybook": "^10.3.5",
    "tailwindcss": "^4.2.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vite-plugin-dts": "^4.5.4"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18"
  }
}
