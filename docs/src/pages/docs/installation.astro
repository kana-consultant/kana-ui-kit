---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import Code from '@/components/ui/code.astro'
import Callout from '@/components/ui/callout.astro'

const installCmd = `pnpm add @kana-consultant/ui-kit
# or
npm install @kana-consultant/ui-kit
# or
yarn add @kana-consultant/ui-kit`

const peerDeps = `pnpm add react react-dom`

const tailwindInstall = `pnpm add -D tailwindcss @tailwindcss/vite`

const viteConfig = `import { defineConfig } from 'vite'
import react from '@vitejs/plugin-react'
import tailwindcss from '@tailwindcss/vite'

export default defineConfig({
  plugins: [react(), tailwindcss()],
})`

const appCss = `@import 'tailwindcss';
@import '@kana-consultant/ui-kit/styles';`

const usageCode = `import { Button, Card } from '@kana-consultant/ui-kit'

export function App() {
  return (
    <Card className="p-6">
      <Button>Ship it</Button>
    </Card>
  )
}`
---

<DocsLayout
  title="Installation"
  description="Install the package, set up Tailwind v4, and render your first component."
>
  <PageHeader
    eyebrow="Getting started"
    title="Installation"
    description="Install the package, set up Tailwind v4, and render your first component."
  />

  <h2>1. Install the package</h2>
  <Code code={installCmd} lang="bash" />

  <h2>2. Peer dependencies</h2>
  <p>
    The kit expects React 18+ or 19+ in your app. Install it if you don't have it yet.
  </p>
  <Code code={peerDeps} lang="bash" />
  <p>
    Everything else (Radix UI, TanStack Form / Store, <code>clsx</code>,
    <code>class-variance-authority</code>, <code>lucide-react</code>, <code>tailwind-merge</code>,
    <code>zod</code>) installs automatically as transitive runtime dependencies.
  </p>

  <h2>3. Tailwind CSS v4</h2>
  <p>
    If your project doesn't have Tailwind v4 yet:
  </p>
  <Code code={tailwindInstall} lang="bash" />
  <p>Register the Vite plugin:</p>
  <Code code={viteConfig} lang="ts" filename="vite.config.ts" />

  <h2>4. Import the styles</h2>
  <p>
    In your app's entry stylesheet, import Tailwind and the kit's design tokens:
  </p>
  <Code code={appCss} lang="css" filename="src/styles/app.css" />

  <Callout tone="info" title="What <code>@kana-consultant/ui-kit/styles</code> ships">
    The kit's CSS exposes the design tokens (color, radii, shadows, fonts) as CSS variables and
    wires them into Tailwind's utility system via <code>@theme inline</code>. Your existing
    Tailwind configuration keeps working — tokens are additive, never destructive.
  </Callout>

  <h2>5. Render a component</h2>
  <Code code={usageCode} lang="tsx" filename="src/app.tsx" />

  <Callout tone="tip" title="Next: configure dark mode">
    Head to <a href="/docs/theming">Theming</a> to enable the theme toggle and customize colors.
  </Callout>
</DocsLayout>
