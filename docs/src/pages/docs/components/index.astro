---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'

const primitives = [
  { name: 'Alert', desc: '5 tones, icon + title + actions', href: '/docs/components/alert' },
  { name: 'Avatar', desc: 'Image + fallback, 5 sizes', href: '/docs/components/avatar' },
  { name: 'Badge', desc: '8 tones, optional dot, 3 sizes', href: '/docs/components/badge' },
  { name: 'Breadcrumb', desc: 'Semantic nav with separator + ellipsis', href: '/docs/components/breadcrumb' },
  { name: 'Button', desc: '7 variants, 5 sizes, loading + icon slots', href: '/docs/components/button' },
  { name: 'Card', desc: 'Header / Title / Content / Footer parts', href: '/docs/components/card' },
  { name: 'Checkbox', desc: 'Indeterminate, keyboard navigable', href: '/docs/components/checkbox' },
  { name: 'Combobox', desc: 'Search-select on Popover + Command — single + multi', href: '/docs/components/combobox' },
  { name: 'Command', desc: 'cmdk palette — input, groups, items, shortcuts', href: '/docs/components/command' },
  { name: 'DataTable', desc: 'TanStack Table — sorting, filtering, pagination, selection', href: '/docs/components/data-table' },
  { name: 'DatePicker', desc: 'Single + range picker with presets', href: '/docs/components/date-picker' },
  { name: 'Dialog', desc: 'Modal with overlay and header/footer', href: '/docs/components/dialog' },
  { name: 'DropdownMenu', desc: 'Items, checkbox / radio, submenus', href: '/docs/components/dropdown-menu' },
  { name: 'Input', desc: 'Icons, invalid state, size variants', href: '/docs/components/input' },
  { name: 'Kbd', desc: 'Keyboard shortcut pill', href: '/docs/components/kbd' },
  { name: 'Label', desc: 'Required indicator, tied to controls', href: '/docs/components/label' },
  { name: 'Pagination', desc: 'Prev/next/first/last + numbered pages', href: '/docs/components/pagination' },
  { name: 'Popover', desc: 'Radix popover with kit shell', href: '/docs/components/popover' },
  { name: 'Progress', desc: '5 tones, bordered bar', href: '/docs/components/progress' },
  { name: 'Select', desc: 'Grouped options, labels, separators', href: '/docs/components/select' },
  { name: 'Separator', desc: 'Horizontal or vertical divider', href: '/docs/components/separator' },
  { name: 'Sheet', desc: 'Side panel — Radix Dialog with slide animation', href: '/docs/components/sheet' },
  { name: 'Skeleton', desc: 'Animated loading placeholder', href: '/docs/components/skeleton' },
  { name: 'Switch', desc: 'Instant-toggle setting', href: '/docs/components/switch' },
  { name: 'Tabs', desc: 'Horizontal tabs with panels', href: '/docs/components/tabs' },
  { name: 'Textarea', desc: 'Multiline input with invalid state', href: '/docs/components/textarea' },
  { name: 'Toast', desc: 'Radix toast — 5 tones, action + close', href: '/docs/components/toast' },
  { name: 'Tooltip', desc: 'Hover / focus tooltip', href: '/docs/components/tooltip' },
]
---

<DocsLayout
  title="Components"
  description="The primitive layer — 18 accessible, Radix-powered components you compose into anything."
>
  <PageHeader
    eyebrow="Primitives"
    title="Components"
    description="Radix-backed primitives. Accessible, keyboard navigable, ARIA-correct. Style with the shipped tokens or override freely."
  />

  <div class="not-prose grid gap-3 sm:grid-cols-2">
    {
      primitives.map((p) => (
        <a
          href={p.href}
          class="group rounded-xl border border-border bg-surface p-4 transition-all hover:border-border-strong hover:shadow-soft"
        >
          <div class="flex items-center justify-between">
            <h3 class="font-mono text-sm font-semibold text-foreground">{p.name}</h3>
            <span class="text-xs text-muted-foreground transition group-hover:text-primary group-hover:translate-x-0.5">
              →
            </span>
          </div>
          <p class="mt-1 text-sm text-muted-foreground">{p.desc}</p>
        </a>
      ))
    }
  </div>
</DocsLayout>
