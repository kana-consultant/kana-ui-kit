---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { SwitchBasicDemo, SwitchGroupDemo } from '@/components/demos/switch-demo'

const code = `const [on, setOn] = useState(true)

<Switch checked={on} onCheckedChange={setOn} />
<Label>Email notifications</Label>`
---

<DocsLayout title="Switch" description="Binary toggle with Radix semantics.">
  <PageHeader
    eyebrow="Primitives"
    title="Switch"
    description="Controlled or uncontrolled toggle. Use for instant settings, not form submissions."
  />

  <h2>Basic</h2>
  <DemoFrame title="Single toggle">
    <SwitchBasicDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>Settings group</h2>
  <DemoFrame title="Stacked toggles">
    <SwitchGroupDemo client:visible />
  </DemoFrame>
</DocsLayout>
