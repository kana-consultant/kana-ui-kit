---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { TooltipBasicDemo, TooltipWithShortcutDemo } from '@/components/demos/tooltip-demo'

const code = `<TooltipProvider>
  <Tooltip>
    <TooltipTrigger asChild>
      <Button variant='secondary' size='icon'><Plus /></Button>
    </TooltipTrigger>
    <TooltipContent>Create new task</TooltipContent>
  </Tooltip>
</TooltipProvider>`
---

<DocsLayout title="Tooltip" description="Hover / focus tooltip with Radix accessibility.">
  <PageHeader
    eyebrow="Primitives"
    title="Tooltip"
    description="Wrap any trigger. Pair with Kbd for shortcut hints."
  />

  <h2>Basic</h2>
  <DemoFrame title="Icon button tooltips">
    <TooltipBasicDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>With keyboard shortcut</h2>
  <DemoFrame title="Compose with Kbd">
    <TooltipWithShortcutDemo client:visible />
  </DemoFrame>
</DocsLayout>
