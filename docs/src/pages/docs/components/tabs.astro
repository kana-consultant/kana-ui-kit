---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { TabsBasicDemo } from '@/components/demos/tabs-demo'

const code = `<Tabs defaultValue='all'>
  <TabsList>
    <TabsTrigger value='all'>All</TabsTrigger>
    <TabsTrigger value='mine'>Mine</TabsTrigger>
    <TabsTrigger value='completed'>Completed</TabsTrigger>
  </TabsList>
  <TabsContent value='all'>...</TabsContent>
  <TabsContent value='mine'>...</TabsContent>
  <TabsContent value='completed'>...</TabsContent>
</Tabs>`
---

<DocsLayout title="Tabs" description="Radix-backed tab list with content panels.">
  <PageHeader
    eyebrow="Primitives"
    title="Tabs"
    description="Horizontal tab bar with content panels. Keyboard navigation included."
  />

  <DemoFrame title="Task list tabs">
    <TabsBasicDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
