---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import PropTable from '@/components/ui/prop-table.astro'
import type { TPropRow } from '@/components/ui/prop-table.astro'
import {
  DatePickerSingleDemo,
  DatePickerRangeDemo,
} from '@/components/demos/date-picker-demo'

const singleCode = `const [date, setDate] = useState<Date | undefined>()

<DatePicker
  value={date}
  onValueChange={setDate}
  placeholder='Select due date'
/>`

const rangeCode = `const [range, setRange] = useState<TDateRange | undefined>()

<DateRangePicker
  value={range}
  onValueChange={setRange}
  placeholder='Pick a date'
/>`

const singleRows: TPropRow[] = [
  { name: 'value', type: 'Date | undefined', default: 'undefined', description: 'Selected date.' },
  { name: 'onValueChange', type: '(value: Date | undefined) => void', default: '—', description: 'Fires when Apply commits a date.' },
  { name: 'placeholder', type: 'string', default: "'Select date'", description: 'Trigger text when value is empty.' },
  { name: 'disabled', type: 'boolean', default: 'false', description: 'Disables the trigger.' },
]

const rangeRows: TPropRow[] = [
  { name: 'value', type: 'TDateRange | undefined', default: 'undefined', description: 'Selected range `{ from?: Date; to?: Date }`.' },
  { name: 'onValueChange', type: '(value: TDateRange | undefined) => void', default: '—', description: 'Fires when Apply commits a range.' },
  { name: 'placeholder', type: 'string', default: "'Select range'", description: 'Trigger text when range is empty.' },
  { name: 'disabled', type: 'boolean', default: 'false', description: 'Disables the trigger.' },
]
---

<DocsLayout title="DatePicker" description="Calendar-popover date and range pickers tied to the Kana surface.">
  <PageHeader
    eyebrow="Primitives"
    title="DatePicker"
    description="Single-date and date-range pickers. Native Date math, Radix popover shell, calendar grid with hover preview and presets."
  />

  <h2>Single date</h2>
  <DemoFrame title="Pick a task deadline">
    <DatePickerSingleDemo client:visible />
  </DemoFrame>
  <Code code={singleCode} lang="tsx" />

  <h2>Date range</h2>
  <DemoFrame title="Filter reports by period">
    <DatePickerRangeDemo client:visible />
  </DemoFrame>
  <Code code={rangeCode} lang="tsx" />

  <h2>Parts</h2>
  <ul>
    <li><code>DatePicker</code> — single-date trigger + popover</li>
    <li><code>DateRangePicker</code> — two triggers + presets + dual-month popover</li>
  </ul>

  <h2>DatePicker props</h2>
  <PropTable rows={singleRows} />

  <h2>DateRangePicker props</h2>
  <PropTable rows={rangeRows} />
</DocsLayout>
