---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { TextareaBasicDemo, TextareaInvalidDemo } from '@/components/demos/textarea-demo'

const code = `<Label htmlFor='desc'>Description</Label>
<Textarea id='desc' placeholder='Add details...' />`
---

<DocsLayout title="Textarea" description="Multiline text input with invalid state.">
  <PageHeader
    eyebrow="Primitives"
    title="Textarea"
    description="Multiline input with the same visual affordances as Input."
  />

  <h2>Basic</h2>
  <DemoFrame title="With label">
    <TextareaBasicDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>Invalid</h2>
  <DemoFrame title="invalid prop + external error">
    <TextareaInvalidDemo client:visible />
  </DemoFrame>
</DocsLayout>
