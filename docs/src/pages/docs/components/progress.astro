---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import PropTable from '@/components/ui/prop-table.astro'
import type { TPropRow } from '@/components/ui/prop-table.astro'
import { ProgressTonesDemo } from '@/components/demos/progress-demo'

const code = `<Progress value={72} tone='primary' />`

const rows: TPropRow[] = [
  { name: 'value', type: 'number', default: '0', description: 'Percent complete (0 – 100).' },
  { name: 'tone', type: "'primary' | 'success' | 'warning' | 'danger' | 'info'", default: "'primary'", description: 'Indicator color.' },
  { name: 'indicatorClassName', type: 'string', description: 'Escape hatch for custom indicator styles.' },
]
---

<DocsLayout title="Progress" description="Linear progress bar with semantic tones.">
  <PageHeader
    eyebrow="Primitives"
    title="Progress"
    description="Radix-backed progress bar in 5 tones."
  />

  <DemoFrame title="All tones" padded>
    <ProgressTonesDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>Props</h2>
  <PropTable rows={rows} />
</DocsLayout>
