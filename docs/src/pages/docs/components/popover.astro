---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import Code from '@/components/ui/code.astro'

const code = `<Popover>
  <PopoverTrigger asChild>
    <Button variant='secondary'>Open</Button>
  </PopoverTrigger>
  <PopoverContent align='start'>
    {/* any content */}
  </PopoverContent>
</Popover>`
---

<DocsLayout title="Popover" description="Radix popover shell with the Kana surface, radius, and shadow.">
  <PageHeader
    eyebrow="Primitives"
    title="Popover"
    description="Floating panel anchored to a trigger. Used internally by DatePicker; exposed for custom menus, filters, and inline editors."
  />

  <h2>Usage</h2>
  <Code code={code} lang="tsx" />

  <h2>Parts</h2>
  <ul>
    <li><code>Popover</code> — root</li>
    <li><code>PopoverTrigger</code></li>
    <li><code>PopoverAnchor</code> — anchor without acting as the trigger</li>
    <li><code>PopoverContent</code> — portaled, styled panel</li>
    <li><code>PopoverArrow</code>, <code>PopoverClose</code></li>
  </ul>
</DocsLayout>
