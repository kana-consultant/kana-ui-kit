---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { DialogDemo, DialogDestructiveDemo } from '@/components/demos/dialog-demo'

const basicCode = `<Dialog>
  <DialogTrigger asChild>
    <Button>Create task</Button>
  </DialogTrigger>
  <DialogContent>
    <DialogHeader>
      <DialogTitle>Create new task</DialogTitle>
      <DialogDescription>Add a task to your board.</DialogDescription>
    </DialogHeader>
    {/* form fields */}
    <DialogFooter>
      <DialogClose asChild>
        <Button variant='ghost'>Cancel</Button>
      </DialogClose>
      <Button>Create</Button>
    </DialogFooter>
  </DialogContent>
</Dialog>`
---

<DocsLayout title="Dialog" description="Modal overlay for destructive actions, forms, and focused flows.">
  <PageHeader
    eyebrow="Primitives"
    title="Dialog"
    description="Radix-backed modal with overlay, scrim, focus trap, and ESC-to-close. Pair it with DialogHeader / DialogFooter helpers."
  />

  <h2>With form</h2>
  <DemoFrame title="Trigger + form + footer">
    <DialogDemo client:visible />
  </DemoFrame>
  <Code code={basicCode} lang="tsx" />

  <h2>Destructive confirmation</h2>
  <DemoFrame title="Confirm a destructive action">
    <DialogDestructiveDemo client:visible />
  </DemoFrame>

  <h2>Parts</h2>
  <ul>
    <li><code>Dialog</code>, <code>DialogTrigger</code>, <code>DialogContent</code></li>
    <li><code>DialogHeader</code>, <code>DialogTitle</code>, <code>DialogDescription</code></li>
    <li><code>DialogFooter</code>, <code>DialogClose</code></li>
  </ul>
</DocsLayout>
