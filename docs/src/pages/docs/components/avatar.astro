---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import PropTable from '@/components/ui/prop-table.astro'
import type { TPropRow } from '@/components/ui/prop-table.astro'
import { AvatarSizesDemo, AvatarImageDemo, AvatarGroupDemo } from '@/components/demos/avatar-demo'

const basicCode = `<Avatar>
  <AvatarImage src='/priya.jpg' alt='Priya' />
  <AvatarFallback>PP</AvatarFallback>
</Avatar>`

const groupCode = `<AvatarGroup size='md' max={4}>
  <Avatar><AvatarFallback>AC</AvatarFallback></Avatar>
  <Avatar><AvatarFallback>ML</AvatarFallback></Avatar>
  <Avatar><AvatarFallback>PP</AvatarFallback></Avatar>
  <Avatar><AvatarFallback>DR</AvatarFallback></Avatar>
  <Avatar><AvatarFallback>KY</AvatarFallback></Avatar>
</AvatarGroup>`

const rows: TPropRow[] = [
  { name: 'size', type: "'xs' | 'sm' | 'md' | 'lg' | 'xl'", default: "'md'", description: 'Diameter.' },
]
const groupRows: TPropRow[] = [
  { name: 'max', type: 'number', default: '4', description: 'How many avatars before the "+N" overflow badge.' },
  { name: 'size', type: "'xs' | 'sm' | 'md' | 'lg' | 'xl'", default: "'sm'", description: 'Applied to every child avatar.' },
]
---

<DocsLayout title="Avatar" description="Circular image representation of a user or entity, with fallback initials.">
  <PageHeader
    eyebrow="Primitives"
    title="Avatar"
    description="Circular image of a user or entity with automatic fallback. Plus AvatarGroup for stacked rows."
  />

  <h2>Sizes</h2>
  <DemoFrame title="xs · sm · md · lg · xl">
    <AvatarSizesDemo client:visible />
  </DemoFrame>

  <h2>With image</h2>
  <DemoFrame title="AvatarImage + AvatarFallback">
    <AvatarImageDemo client:visible />
  </DemoFrame>
  <Code code={basicCode} lang="tsx" />

  <h3>Avatar props</h3>
  <PropTable rows={rows} />

  <h2>AvatarGroup</h2>
  <DemoFrame title="Auto-overflow with +N">
    <AvatarGroupDemo client:visible />
  </DemoFrame>
  <Code code={groupCode} lang="tsx" />

  <h3>AvatarGroup props</h3>
  <PropTable rows={groupRows} />
</DocsLayout>
