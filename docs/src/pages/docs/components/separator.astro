---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { SeparatorHorizontalDemo } from '@/components/demos/separator-demo'

const code = `<Separator />
<Separator orientation='vertical' />`
---

<DocsLayout title="Separator" description="Horizontal or vertical divider.">
  <PageHeader
    eyebrow="Primitives"
    title="Separator"
    description="Thin horizontal or vertical divider. Decorative by default."
  />

  <DemoFrame title="Horizontal + vertical">
    <SeparatorHorizontalDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
