---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import PropTable from '@/components/ui/prop-table.astro'
import type { TPropRow } from '@/components/ui/prop-table.astro'
import { AlertTonesDemo } from '@/components/demos/alert-demo'

const basicCode = `<Alert tone='info'>
  <AlertIcon>
    <Info />
  </AlertIcon>
  <AlertContent>
    <AlertTitle>Sprint report ready</AlertTitle>
    <AlertDescription>Velocity and carry-over metrics are available for review.</AlertDescription>
    <AlertActions>
      <Button variant='ghost' size='sm'>Dismiss</Button>
      <Button variant='soft' size='sm'>View report</Button>
    </AlertActions>
  </AlertContent>
</Alert>`

const rows: TPropRow[] = [
  { name: 'tone', type: "'default' | 'info' | 'success' | 'warning' | 'danger'", default: "'default'", description: 'Semantic accent for the left border and icon tile.' },
]
---

<DocsLayout title="Alert" description="In-flow notice with icon, title, description, and optional actions.">
  <PageHeader
    eyebrow="Primitives"
    title="Alert"
    description="Static in-page banner for status, confirmations, warnings, and errors. Composes an icon tile, copy, and an optional action row."
  />

  <h2>Tones</h2>
  <DemoFrame title="info / success / warning / danger">
    <AlertTonesDemo client:visible />
  </DemoFrame>
  <Code code={basicCode} lang="tsx" />

  <h2>Parts</h2>
  <ul>
    <li><code>Alert</code> — root container, owns the tone</li>
    <li><code>AlertIcon</code> — square icon tile that inherits the tone</li>
    <li><code>AlertContent</code> — title / description / actions column</li>
    <li><code>AlertTitle</code>, <code>AlertDescription</code></li>
    <li><code>AlertActions</code> — right-aligned action row</li>
  </ul>

  <h2>Props</h2>
  <PropTable rows={rows} />
</DocsLayout>
