---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import {
  DropdownBasicDemo,
  DropdownActionsDemo,
  DropdownCheckboxDemo,
} from '@/components/demos/dropdown-menu-demo'

const basicCode = `<DropdownMenu>
  <DropdownMenuTrigger asChild>
    <Button>Account</Button>
  </DropdownMenuTrigger>
  <DropdownMenuContent align='end'>
    <DropdownMenuLabel>Priya Patel</DropdownMenuLabel>
    <DropdownMenuSeparator />
    <DropdownMenuItem>Profile</DropdownMenuItem>
    <DropdownMenuItem>Settings</DropdownMenuItem>
  </DropdownMenuContent>
</DropdownMenu>`
---

<DocsLayout title="DropdownMenu" description="Menu attached to a trigger with items, separators, checkbox / radio variants, and submenus.">
  <PageHeader
    eyebrow="Primitives"
    title="DropdownMenu"
    description="Menu with items, separators, checkbox / radio variants, and nested submenus."
  />

  <h2>Basic</h2>
  <DemoFrame title="Account dropdown">
    <DropdownBasicDemo client:visible />
  </DemoFrame>
  <Code code={basicCode} lang="tsx" />

  <h2>Actions (icon trigger)</h2>
  <DemoFrame title="Row-level actions">
    <DropdownActionsDemo client:visible />
  </DemoFrame>

  <h2>Checkbox &amp; radio items</h2>
  <DemoFrame title="Stateful items">
    <DropdownCheckboxDemo client:visible />
  </DemoFrame>

  <h2>Parts</h2>
  <ul>
    <li><code>DropdownMenu</code>, <code>DropdownMenuTrigger</code>, <code>DropdownMenuContent</code></li>
    <li><code>DropdownMenuItem</code>, <code>DropdownMenuCheckboxItem</code>, <code>DropdownMenuRadioItem</code></li>
    <li><code>DropdownMenuLabel</code>, <code>DropdownMenuSeparator</code>, <code>DropdownMenuShortcut</code></li>
    <li><code>DropdownMenuSub</code>, <code>DropdownMenuSubTrigger</code>, <code>DropdownMenuSubContent</code></li>
    <li><code>DropdownMenuRadioGroup</code>, <code>DropdownMenuGroup</code>, <code>DropdownMenuPortal</code></li>
  </ul>
</DocsLayout>
