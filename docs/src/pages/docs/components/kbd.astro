---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { KbdDemo } from '@/components/demos/kbd-demo'

const code = `<span>Save <Kbd>⌘</Kbd><Kbd>S</Kbd></span>`
---

<DocsLayout title="Kbd" description="Keyboard shortcut badge.">
  <PageHeader
    eyebrow="Primitives"
    title="Kbd"
    description="Minimal keyboard shortcut pill. Compose multiple Kbd elements for chords."
  />

  <DemoFrame title="Shortcut hints">
    <KbdDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
