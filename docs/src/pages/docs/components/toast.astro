---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import PropTable from '@/components/ui/prop-table.astro'
import type { TPropRow } from '@/components/ui/prop-table.astro'
import {
  ToastBasicDemo,
  ToastWithActionDemo,
  ToastDangerDemo,
} from '@/components/demos/toast-demo'

const setupCode = `// Mount once at the app root
<ToastProvider swipeDirection='right'>
  <App />
  <ToastViewport />
</ToastProvider>`

const usageCode = `<Toast tone='success' open={open} onOpenChange={setOpen}>
  <ToastIcon><CheckCircle2 /></ToastIcon>
  <ToastBody>
    <ToastTitle>Task created</ToastTitle>
    <ToastDescription>The task was added to Backlog.</ToastDescription>
  </ToastBody>
  <ToastAction altText='Undo'>Undo</ToastAction>
  <ToastClose />
</Toast>`

const rows: TPropRow[] = [
  { name: 'tone', type: "'default' | 'info' | 'success' | 'warning' | 'danger'", default: "'default'", description: 'Tints the icon tile and ToastAction border.' },
  { name: 'open', type: 'boolean', default: '—', description: 'Controlled open state (Radix Toast prop).' },
  { name: 'onOpenChange', type: '(open: boolean) => void', default: '—', description: 'Fires when the toast opens or closes.' },
  { name: 'duration', type: 'number', default: '5000', description: 'Auto-dismiss delay in ms (Radix Toast prop).' },
]
---

<DocsLayout title="Toast" description="Radix-backed transient notification stacked in the bottom-right.">
  <PageHeader
    eyebrow="Primitives"
    title="Toast"
    description="Transient stack of notifications. Mount ToastProvider + ToastViewport at the app root, then render each Toast as needed."
  />

  <h2>Setup</h2>
  <Code code={setupCode} lang="tsx" />

  <h2>Success</h2>
  <DemoFrame title="Plain success toast">
    <ToastBasicDemo client:visible />
  </DemoFrame>
  <Code code={usageCode} lang="tsx" />

  <h2>With action</h2>
  <DemoFrame title="Info toast with Undo">
    <ToastWithActionDemo client:visible />
  </DemoFrame>

  <h2>Danger</h2>
  <DemoFrame title="Failure with retry">
    <ToastDangerDemo client:visible />
  </DemoFrame>

  <h2>Parts</h2>
  <ul>
    <li><code>ToastProvider</code> — wraps the app, configures swipe</li>
    <li><code>ToastViewport</code> — fixed bottom-right stack target</li>
    <li><code>Toast</code> — single notification, owns the tone</li>
    <li><code>ToastIcon</code> — colored icon tile</li>
    <li><code>ToastBody</code> — title + description column</li>
    <li><code>ToastTitle</code>, <code>ToastDescription</code></li>
    <li><code>ToastAction</code> — accent-bordered action button</li>
    <li><code>ToastClose</code> — square X button</li>
  </ul>

  <h2>Props</h2>
  <PropTable rows={rows} />
</DocsLayout>
