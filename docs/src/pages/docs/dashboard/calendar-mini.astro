---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { CalendarMiniDemo } from '@/components/demos/calendar-mini-demo'

const code = `const [date, setDate] = useState<Date>(new Date())

<CalendarMini
  selected={date}
  onSelect={setDate}
  markedDates={[new Date(), tomorrow]}
/>`
---

<DocsLayout title="CalendarMini" description="Compact month grid with selection and date markers.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="CalendarMini"
    description="Month-view calendar. Navigate with the header chevrons. Dots mark dates with activity."
  />

  <DemoFrame title="Pick a date">
    <CalendarMiniDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
