---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import Callout from '@/components/ui/callout.astro'
import { DashboardShellDemo } from '@/components/demos/dashboard-shell-demo'

const code = `<DashboardShell
  sidebar={<Sidebar items={nav} activeId='dashboard' />}
  topBar={<TopBar title='Dashboard' user={user} />}
>
  {/* your page content */}
</DashboardShell>`
---

<DocsLayout
  title="DashboardShell"
  description="The outermost layout wrapper — Sidebar + TopBar + scrollable main area."
>
  <PageHeader
    eyebrow="Dashboard blocks"
    title="DashboardShell"
    description="Assembles a Sidebar and TopBar around your page content with proper scrolling, sizing, and overflow."
  />

  <DemoFrame title="Full shell" padded={false}>
    <DashboardShellDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <Callout tone="tip" title="Pair with a router">
    DashboardShell is layout-only. Render your router outlet inside it —
    <code>children</code> is where your routes live.
  </Callout>
</DocsLayout>
