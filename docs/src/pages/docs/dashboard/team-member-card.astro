---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { TeamMemberCardSingleDemo, TeamMemberCardGridDemo } from '@/components/demos/team-member-card-demo'

const code = `<TeamMemberCard
  member={{ id: 'u1', name: 'Ava Chen', role: 'Product Designer' }}
  online
/>`
---

<DocsLayout title="TeamMemberCard" description="Person card with avatar, name, role, and online indicator.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="TeamMemberCard"
    description="Compact person card. Generic enough for any user / entity list."
  />

  <h2>Single</h2>
  <DemoFrame title="One member">
    <TeamMemberCardSingleDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>Grid</h2>
  <DemoFrame title="Two column list">
    <TeamMemberCardGridDemo client:visible />
  </DemoFrame>
</DocsLayout>
