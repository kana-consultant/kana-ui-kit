---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { ActivityFeedDemo } from '@/components/demos/activity-feed-demo'

const code = `<ActivityFeed
  items={[
    { id: 'a1', actor: ava, verb: 'completed', target: 'Ship the thing', at: '2m ago' },
    { id: 'a2', actor: marcus, verb: 'commented on', target: 'Fix bug', at: '10m ago' },
  ]}
/>`
---

<DocsLayout title="ActivityFeed" description="Timeline with avatar rail for audit logs and change history.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="ActivityFeed"
    description="Chronological list of events with an avatar rail and connector line. Perfect for audit logs."
  />

  <DemoFrame title="Activity timeline">
    <ActivityFeedDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
