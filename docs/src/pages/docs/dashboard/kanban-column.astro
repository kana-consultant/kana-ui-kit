---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { KanbanBoardDemo } from '@/components/demos/kanban-column-demo'

const code = `<KanbanColumn
  title='In progress'
  status={EStatus.InProgress}
  color='#7c3aed'
  tasks={tasks.filter((t) => t.status === EStatus.InProgress)}
  onAdd={(status) => openNewTask(status)}
  onToggle={(id, done) => updateTask(id, done)}
/>`
---

<DocsLayout title="KanbanColumn" description="Titled column with count, color dot, add button, and stacked TaskCards.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="KanbanColumn"
    description="Compose multiple columns side by side to build a Kanban board for any pipeline."
  />

  <DemoFrame title="Full board" padded={false}>
    <div class="w-full p-4">
      <KanbanBoardDemo client:visible />
    </div>
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
