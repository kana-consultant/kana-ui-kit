---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import PropTable from '@/components/ui/prop-table.astro'
import type { TPropRow } from '@/components/ui/prop-table.astro'
import { StatCardSingleDemo, StatCardGridDemo } from '@/components/demos/stat-card-demo'

const code = `<StatCard
  id='active'
  label='Active tasks'
  value={42}
  icon={ListTodo}
  tone='primary'
  delta={{ value: 12, direction: 'up' }}
  hint='Across 6 projects'
/>`

const rows: TPropRow[] = [
  { name: 'label', type: 'string', description: 'Small uppercase label above the value.' },
  { name: 'value', type: 'string | number', description: 'The primary metric.' },
  { name: 'icon', type: 'LucideIcon', description: 'Icon rendered in a colored tile on the right.' },
  { name: 'tone', type: "'primary' | 'accent' | 'success' | 'warning' | 'info' | 'neutral'", default: "'primary'", description: 'Tile color.' },
  { name: 'delta', type: '{ value: number; direction: "up" | "down" | "flat" }', description: 'Optional comparison to previous period.' },
  { name: 'hint', type: 'string', description: 'Small text under the value.' },
]
---

<DocsLayout title="StatCard" description="KPI card with value, icon, tone, and delta indicator.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="StatCard"
    description="Headline metric in a card. Supports delta comparisons with direction and color."
  />

  <h2>Single</h2>
  <DemoFrame title="One stat">
    <StatCardSingleDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>Grid</h2>
  <DemoFrame title="Four across">
    <StatCardGridDemo client:visible />
  </DemoFrame>

  <h2>Props</h2>
  <PropTable rows={rows} />
</DocsLayout>
