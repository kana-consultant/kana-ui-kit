---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { SidebarDemo } from '@/components/demos/sidebar-demo'

const code = `<Sidebar
  items={nav}
  secondaryItems={navSecondary}
  activeId={active}
  onNavigate={setActive}
  footer={<UserChip />}
/>`
---

<DocsLayout title="Sidebar" description="Grouped nav with badges, active state, and footer slot.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="Sidebar"
    description="Primary navigation. Groups, badges, active state, brand slot, footer slot."
  />

  <DemoFrame title="Full sidebar" padded={false}>
    <SidebarDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />
</DocsLayout>
