---
import DocsLayout from '@/layouts/docs-layout.astro'
import PageHeader from '@/components/ui/page-header.astro'
import DemoFrame from '@/components/ui/demo-frame.astro'
import Code from '@/components/ui/code.astro'
import { ProjectCardSingleDemo, ProjectCardGridDemo } from '@/components/demos/project-card-demo'

const code = `<ProjectCard
  project={{
    id: 'p1',
    name: 'Tasko Redesign',
    color: '#7c3aed',
    progress: 72,
    dueDate: 'May 12',
    members: [...],
    tasksDone: 18,
    tasksTotal: 25,
  }}
  onOpen={(id) => navigate('/projects/' + id)}
/>`
---

<DocsLayout title="ProjectCard" description="Card for a collection with color bar, progress, member group, and completion ratio.">
  <PageHeader
    eyebrow="Dashboard blocks"
    title="ProjectCard"
    description="Generic 'collection' card. Colored top bar, progress bar, stacked member avatars, task completion ratio."
  />

  <h2>Single</h2>
  <DemoFrame title="One project">
    <ProjectCardSingleDemo client:visible />
  </DemoFrame>
  <Code code={code} lang="tsx" />

  <h2>Grid</h2>
  <DemoFrame title="Three across">
    <ProjectCardGridDemo client:visible />
  </DemoFrame>
</DocsLayout>
