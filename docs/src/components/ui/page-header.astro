---
type TProps = {
  eyebrow?: string
  title: string
  description?: string
}

const { eyebrow, title, description } = Astro.props as TProps
---

<header class="mb-10 border-b border-border pb-8">
  {
    eyebrow && (
      <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-primary">{eyebrow}</p>
    )
  }
  <h1 class="text-balance text-4xl font-bold tracking-tight text-foreground sm:text-5xl">
    {title}
  </h1>
  {description && <p class="mt-3 max-w-2xl text-lg text-muted-foreground">{description}</p>}
</header>
