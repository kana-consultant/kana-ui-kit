---
export type TPropRow = {
  name: string
  type: string
  default?: string
  description?: string
}

type TProps = {
  rows: TPropRow[]
}

const { rows } = Astro.props as TProps
---

<div class="my-4 overflow-x-auto rounded-xl border border-border">
  <table class="w-full text-left text-sm">
    <thead class="bg-surface-muted text-xs uppercase tracking-wider text-muted-foreground">
      <tr>
        <th class="px-4 py-2.5 font-semibold">Prop</th>
        <th class="px-4 py-2.5 font-semibold">Type</th>
        <th class="px-4 py-2.5 font-semibold">Default</th>
        <th class="px-4 py-2.5 font-semibold">Description</th>
      </tr>
    </thead>
    <tbody>
      {
        rows.map((row) => (
          <tr class="border-t border-border align-top">
            <td class="px-4 py-2.5 font-mono text-xs font-semibold text-primary">{row.name}</td>
            <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">{row.type}</td>
            <td class="px-4 py-2.5 font-mono text-xs text-muted-foreground">{row.default ?? '—'}</td>
            <td class="px-4 py-2.5 text-sm">{row.description ?? ''}</td>
          </tr>
        ))
      }
    </tbody>
  </table>
</div>
