---
type TTone = 'info' | 'success' | 'warning' | 'danger' | 'tip'

type TProps = {
  tone?: TTone
  title?: string
}

const { tone = 'info', title } = Astro.props as TProps

const toneMap: Record<TTone, { bg: string; border: string; text: string; icon: string }> = {
  info: {
    bg: 'bg-info/10',
    border: 'border-info/30',
    text: 'text-info',
    icon: 'i',
  },
  success: {
    bg: 'bg-success/10',
    border: 'border-success/30',
    text: 'text-success',
    icon: '✓',
  },
  warning: {
    bg: 'bg-warning/15',
    border: 'border-warning/40',
    text: 'text-warning-foreground dark:text-warning',
    icon: '!',
  },
  danger: {
    bg: 'bg-danger/10',
    border: 'border-danger/30',
    text: 'text-danger',
    icon: '✕',
  },
  tip: {
    bg: 'bg-primary-soft',
    border: 'border-primary/20',
    text: 'text-primary',
    icon: '★',
  },
}

const t = toneMap[tone]
---

<aside class={`my-4 flex gap-3 rounded-xl border ${t.border} ${t.bg} p-4`}>
  <span
    class={`inline-flex size-6 shrink-0 items-center justify-center rounded-full border ${t.border} ${t.text} text-xs font-bold`}
    aria-hidden="true"
  >
    {t.icon}
  </span>
  <div class="flex-1 text-sm">
    {title && <p class={`mb-1 font-semibold ${t.text}`}>{title}</p>}
    <div class="text-foreground/90 leading-relaxed [&>p]:!m-0">
      <slot />
    </div>
  </div>
</aside>
