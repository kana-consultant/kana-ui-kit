---
type TProps = {
  size?: 'sm' | 'md' | 'lg' | 'xl' | 'full'
  class?: string
}

const { size = 'lg', class: className = '' } = Astro.props as TProps

const sizeMap = {
  sm: 'max-w-2xl',
  md: 'max-w-4xl',
  lg: 'max-w-6xl',
  xl: 'max-w-7xl',
  full: 'max-w-none',
}
---

<div class={`mx-auto w-full px-4 sm:px-6 ${sizeMap[size]} ${className}`}>
  <slot />
</div>
