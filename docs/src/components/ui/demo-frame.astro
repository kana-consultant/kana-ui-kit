---
type TProps = {
  title?: string
  padded?: boolean
}

const { title, padded = true } = Astro.props as TProps
---

<figure class="my-4 overflow-hidden rounded-xl border border-border bg-surface">
  {
    title && (
      <figcaption class="flex items-center gap-2 border-b border-border bg-surface-muted px-4 py-2 text-xs font-medium text-muted-foreground">
        <span class="inline-block size-1.5 rounded-full bg-primary" />
        {title}
      </figcaption>
    )
  }
  <div
    class:list={[
      'relative flex min-h-32 flex-wrap items-center justify-center gap-3 bg-background',
      padded && 'p-8',
    ]}
  >
    <slot />
  </div>
</figure>
