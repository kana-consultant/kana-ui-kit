---
import Container from '@/components/ui/container.astro'
import GridPattern from '@/components/ui/grid-pattern.astro'
import { kitVersion } from '@/lib/version'
---

<section class="relative isolate overflow-hidden border-b border-border">
  <GridPattern class="text-muted-foreground" />
  <div
    class="pointer-events-none absolute -top-20 left-1/2 h-[600px] w-[900px] -translate-x-1/2 rounded-full bg-[radial-gradient(ellipse_at_center,color-mix(in_oklch,var(--primary)_25%,transparent)_0%,transparent_70%)] blur-3xl"
    aria-hidden="true"
  >
  </div>
  <Container size="xl" class="relative flex flex-col items-center py-24 text-center sm:py-32">
    <a
      href="https://www.npmjs.com/package/@kana-consultant/ui-kit"
      target="_blank"
      rel="noreferrer"
      class="group mb-8 inline-flex items-center gap-2 rounded-full border border-border bg-surface/60 px-3 py-1 text-xs font-medium text-muted-foreground backdrop-blur transition hover:border-primary/30 hover:text-foreground"
    >
      <span class="relative flex size-1.5">
        <span class="absolute inline-flex size-full animate-ping rounded-full bg-success/70"></span>
        <span class="relative inline-flex size-1.5 rounded-full bg-success"></span>
      </span>
      <span>v{kitVersion} live on npm</span>
      <span class="text-muted-foreground/60 transition group-hover:translate-x-0.5 group-hover:text-primary">→</span>
    </a>

    <h1
      class="max-w-4xl text-balance text-5xl font-bold tracking-tight text-foreground sm:text-7xl"
    >
      Ship back-office
      <span
        class="bg-gradient-to-br from-primary via-primary to-accent bg-clip-text text-transparent"
      >
        10× faster
      </span>
    </h1>

    <p class="mt-6 max-w-2xl text-balance text-lg leading-relaxed text-muted-foreground sm:text-xl">
      A modern React UI kit for admin dashboards and internal tools. Accessible primitives,
      dashboard blocks, and TanStack integrations — all typed, all themeable, all yours.
    </p>

    <div class="mt-10 flex flex-wrap items-center justify-center gap-3">
      <a
        href="/docs/installation"
        class="group inline-flex h-12 items-center justify-center gap-2 rounded-md bg-primary px-6 text-sm font-semibold text-primary-foreground shadow-soft transition hover:brightness-110"
      >
        Get started
        <span class="transition group-hover:translate-x-0.5">→</span>
      </a>
      <a
        href="https://kana-ui-kit-storybook.pages.dev"
        target="_blank"
        rel="noreferrer"
        class="inline-flex h-12 items-center justify-center gap-2 rounded-md border border-border bg-surface/80 px-6 text-sm font-semibold text-foreground shadow-soft backdrop-blur transition hover:bg-muted"
      >
        Open Storybook
      </a>
    </div>

    <div class="mt-10 flex items-center gap-3 rounded-lg border border-border bg-surface/60 px-4 py-2 font-mono text-xs text-muted-foreground backdrop-blur sm:text-sm">
      <span class="text-primary">$</span>
      <span>pnpm add @kana-consultant/ui-kit</span>
      <button
        type="button"
        data-copy="pnpm add @kana-consultant/ui-kit"
        class="inline-flex size-6 items-center justify-center rounded text-muted-foreground/60 transition hover:bg-muted hover:text-foreground"
        aria-label="Copy command"
      >
        <svg class="size-3.5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <rect width="14" height="14" x="8" y="8" rx="2"></rect>
          <path d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"></path>
        </svg>
      </button>
    </div>
  </Container>
</section>

<script>
  document.addEventListener('click', async (e) => {
    const target = e.target
    if (!(target instanceof Element)) return
    const btn = target.closest<HTMLElement>('[data-copy]')
    if (!btn) return
    const text = btn.dataset.copy
    if (!text) return
    await navigator.clipboard.writeText(text)
    btn.classList.add('text-success')
    setTimeout(() => btn.classList.remove('text-success'), 1200)
  })
</script>
